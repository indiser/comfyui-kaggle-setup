{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "image_chrono_edit_input_image.png" },
    "_meta": { "title": "Load Image" }
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "chrono_edit_14B_fp16.safetensors", "weight_dtype": "fp8_e4m3fn" },
    "_meta": { "title": "Load Diffusion Model" }
  },
  "3": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["2", 0],
      "lora_name": "chronoedit_distill_lora.safetensors",
      "strength_model": 1.0
    },
    "_meta": { "title": "Distill LoRA" }
  },
  "4": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" },
    "_meta": { "title": "Load CLIP" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "wan_2.1_vae.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "6": {
    "class_type": "CLIPVisionLoader",
    "inputs": { "clip_name": "clip_vision_h.safetensors" },
    "_meta": { "title": "Load CLIP Vision" }
  },
  "7": {
    "class_type": "CLIPVisionEncode",
    "inputs": { "clip_vision": ["6", 0], "image": ["1", 0], "crop": "none" },
    "_meta": { "title": "CLIP Vision Encode" }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["4", 0],
      "text": "EDIT PROMPT HERE. Long and detailed. Describe the final edited image in full: subject, change, lighting, background, style, quality."
    },
    "_meta": { "title": "Positive Prompt" }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["4", 0],
      "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走"
    },
    "_meta": { "title": "Negative Prompt" }
  },
  "10": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": ["8", 0],
      "negative": ["9", 0],
      "vae": ["5", 0],
      "clip_vision_output": ["7", 0],
      "start_image": ["1", 0],
      "width": 720,
      "height": 720,
      "length": 5,
      "batch_size": 1
    },
    "_meta": { "title": "WanImageToVideo" }
  },
  "11": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["3", 0], "shift": 2 },
    "_meta": { "title": "ModelSamplingSD3" }
  },
  "12": {
    "class_type": "ScaleROPE",
    "inputs": {
      "model": ["11", 0],
      "scale_x": 1, "shift_x": 0,
      "scale_y": 1, "shift_y": 0,
      "scale_t": 7, "shift_t": 0
    },
    "_meta": { "title": "ScaleROPE" }
  },
  "13": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["12", 0],
      "positive": ["10", 0],
      "negative": ["10", 1],
      "latent_image": ["10", 2],
      "seed": 859991172109574,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": { "title": "KSampler" }
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["13", 0], "vae": ["5", 0] },
    "_meta": { "title": "VAE Decode" }
  },
  "15": {
    "class_type": "ImageFromBatch",
    "inputs": { "image": ["14", 0], "batch_index": 4, "length": 1 },
    "_meta": { "title": "Get Last Frame" }
  },
  "16": {
    "class_type": "SaveImage",
    "inputs": { "images": ["15", 0], "filename_prefix": "Chrono_Edit_14B" },
    "_meta": { "title": "Save Image" }
  }
}
